# Select one real provider. Only the selected provider's key is required.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_INPUT_CHARS=2000
MAX_BODY_BYTES=16384
RATE_LIMIT_PER_IP=5
RATE_LIMIT_GLOBAL=5
RATE_WINDOW_SECONDS=60
MAX_CONCURRENT_ANALYSES=2
MODEL_ATTEMPT_TIMEOUT_SECONDS=20
MODEL_TOTAL_TIMEOUT_SECONDS=45
# JSON list; explicitly allow the frontend's origin. No wildcard credentials.
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
